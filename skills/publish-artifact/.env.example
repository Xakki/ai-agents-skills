# publish-artifact config — copy to ~/.config/artifact-publish/.env (chmod 600).
# NEVER commit a filled-in copy — only this template lives in the repo.

# The project whose Makefile exposes a `publish-artifact` target.
ARTIFACT_PROJECT_DIR=/home/xakki/xakki.pro

# Optional overrides consumed by the project's bin/publish-artifact.sh:
# ARTIFACT_DIR=<abs path to the served artifact dir>
# ARTIFACT_BASE_URL=https://xakki.pro
